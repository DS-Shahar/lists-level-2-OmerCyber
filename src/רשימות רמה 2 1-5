    public static Node<Integer> buildList(int[] a)
    {
        Node<Integer> h = new Node<Integer>(a[0]);
        Node<Integer> p = h;
        Node<Integer> x;
        for (int i = 1; i < a.length; i++)
        {
            x = new Node<Integer>(a[i]);
            p.setNext(x);
            p = p.getNext();
        }
        return h;
    }

    public static void PrintNode(Node<Integer> p)
    {
        while (p != null)
        {
            System.out.println(p.getValue());
            p = p.getNext();
        }
    }

    public static int SumNode(Node<Integer> p)
    {
        int s = 0;
        while (p != null)
        {
            s += p.getValue();
            p = p.getNext();
        }
        return s;
    }





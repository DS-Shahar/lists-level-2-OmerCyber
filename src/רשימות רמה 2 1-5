    public static Node<Integer> ex_5(Node<Integer> list)
    {
        Node<Integer> h = null;
        Node<Integer> p = null;

        Node<Integer> q = list;
        while (q != null)
        {
            if (!contains(h, q.getValue()))
            {
                Node<Integer> x = new Node<Integer>(q.getValue());
                if (h == null)
                {
                    h = x;
                    p = x;
                }
                else
                {
                    p.setNext(x);
                    p = x;
                }
            }
            q = q.getNext();
        }

        return h;
    }

   public static boolean contains(Node<Integer> list, int val)
    {
        Node<Integer> p = list;
        while (p != null)
        {
            if (p.getValue() == val)
            {
                return true;
            }
            p = p.getNext();
        }
        return false;
    }
